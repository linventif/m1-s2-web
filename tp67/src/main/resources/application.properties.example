spring.application.name=tp

# TMDB
tmdb.api-key=${TMDB_API_KEY:YOUR_TMDB_API_KEY}
tmdb.base-url=${TMDB_BASE_URL:https://api.themoviedb.org/3}

# Configuration PostgreSQL
spring.datasource.url=${SPRING_DATASOURCE_URL:jdbc:postgresql://localhost:5432/conferences}
spring.datasource.driver-class-name=org.postgresql.Driver
spring.datasource.username=${SPRING_DATASOURCE_USERNAME:psql}
spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:psql}

# Configuration of Hibernate
spring.jpa.database-platform=org.hibernate.dialect.PostgreSQLDialect
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true
